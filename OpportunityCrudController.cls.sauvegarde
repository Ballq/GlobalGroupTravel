@IsTest
private class OpportunityCrudControllerTest {

    @IsTest
    static void testCreateOpportunity() {

        Account account = TestDataFactory.createTestAccount();
        insert account;

        Test.startTest();

        Opportunity opportunity =
            OpportunityCrudController.createOpportunity(
                'Voyage Paris',
                account.Id,
                'Prospecting',
                Date.today().addDays(30),
                5000,
                'Paris',
                Date.today().addDays(10),
                Date.today().addDays(15),
                20
            );

        Test.stopTest();

        System.assertNotEquals(
            null,
            opportunity.Id,
            'L’opportunité doit être créée.'
        );

        System.assertEquals(
            'Voyage Paris',
            opportunity.Name
        );

        System.assertEquals(
            account.Id,
            opportunity.AccountId
        );

        System.assertEquals(
            'Prospecting',
            opportunity.StageName
        );

        System.assertEquals(
            5000,
            opportunity.Amount
        );

        System.assertEquals(
            'Paris',
            opportunity.Destination__c
        );

        System.assertEquals(
            20,
            opportunity.Number_of_Participants__c
        );
    }


    @IsTest
    static void testCreateOpportunityWithEmptyName() {

        Account account = TestDataFactory.createTestAccount();
        insert account;

        Boolean exceptionThrown = false;

        Test.startTest();

        try {
            OpportunityCrudController.createOpportunity(
                '',
                account.Id,
                'Prospecting',
                Date.today().addDays(30),
                5000,
                'Paris',
                Date.today().addDays(10),
                Date.today().addDays(15),
                20
            );
        } catch (AuraHandledException e) {
            exceptionThrown = true;
        }

        Test.stopTest();

        System.assertEquals(
            true,
            exceptionThrown,
            'Une erreur doit être levée si le nom est vide.'
        );
    }


