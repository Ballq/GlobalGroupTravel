    @IsTest
    static void testDeleteOpportunity() {

        Account account = TestDataFactory.createTestAccount();
        insert account;

        Opportunity opportunity =
            TestDataFactory.createTestOpportunity(account.Id);

        insert opportunity;

        Test.startTest();

        OpportunityCrudController.deleteOpportunity(
            opportunity.Id
        );

        Test.stopTest();

        Integer opportunityCount = [
            SELECT COUNT()
            FROM Opportunity
            WHERE Id = :opportunity.Id
        ];

        System.assertEquals(
            0,
            opportunityCount,
            'L’opportunité doit être supprimée.'
        );
    }


