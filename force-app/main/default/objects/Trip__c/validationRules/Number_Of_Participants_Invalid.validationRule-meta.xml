<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Number_Of_Participants_Invalid</fullName>
    <active>true</active>
    <errorConditionFormula>Number_of_Participants__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Number_of_Participants__c</errorDisplayField>
    <errorMessage>Le nombre de participants doit être supérieur à zéro.</errorMessage>
</ValidationRule>
